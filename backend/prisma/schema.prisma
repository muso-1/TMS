// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          Int           @id @default(autoincrement())
  name        String
  email       String        @unique
  phone       String
  
  units       Unit[]        
  leases      Lease[]       
  waterBills  WaterBill[]   
  maintenance Maintenance[]

  payments    Payment[]     // added: direct link to payments
}

model Unit {
  id         Int     @id @default(autoincrement())
  unitNumber String
  status     String  @default("vacant")
  tenantId   Int?
  tenant     Tenant? @relation(fields: [tenantId], references: [id])

  leases     Lease[]

  waterBills WaterBill[]
  meterReadings WaterMeterReading[] 
}

enum LeaseStatus {
  active
  terminated
  expired
  pending
}

model Lease {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  unitId      Int
  unit        Unit     @relation(fields: [unitId], references: [id])
  
  status      LeaseStatus @default(active)
  
  monthlyRent Float
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rentBills RentBill[]
}

enum BillStatus {
  unpaid
  partially_paid
  paid
  overdue
  voided
}

model RentBill {
  id                    Int       @id @default(autoincrement())
  amount                Float
  totalRentPaid         Float        @default(0)

  outstandingAmount     Float?

  status                BillStatus   @default(unpaid)
  dueDate               DateTime
  reminderSent          Boolean   @default(false)
  reminderSentAt        DateTime?
  leaseId               Int
  lease                 Lease     @relation(fields: [leaseId], references: [id])

  allocations           PaymentAllocation[]

  createdAt             DateTime  @default(now())
  paidAt                DateTime?

  // VOIDING
  isVoided              Boolean  @default(false)
  voidedAt              DateTime?
  voidReason            String?

  @@index([dueDate])
  @@index([leaseId])
}

model WaterBill {
  id                    Int      @id @default(autoincrement())
  tenantId              Int
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  
  unitId                Int
  unit                  Unit     @relation(fields: [unitId], references: [id])

  meterReadingId        Int? @unique

  meterReading          WaterMeterReading? @relation(fields: [meterReadingId], references: [id])
    
  previousReading       Int      @default(0)
  currentReading        Int
  unitsUsed             Int
  amount                Float
  totalWaterPaid        Float        @default(0)

  outstandingAmount     Float
  
  billingCycle          String
  ratePerUnit           Float

  status                BillStatus   @default(unpaid)
  dueDate               DateTime

  allocations           PaymentAllocation[]

  paidAt                DateTime?
  
  reminderSent          Boolean   @default(false)
  reminderSentAt        DateTime?
  
  createdAt             DateTime  @default(now())

  // VOIDING
  isVoided              Boolean  @default(false)
  voidedAt              DateTime?
  voidReason            String?

  @@unique([unitId, billingCycle])
}

model WaterMeterReading {
  id          Int      @id @default(autoincrement())

  unitId      Int
  unit        Unit     @relation(fields: [unitId], references: [id])

  reading     Int
  readingDate DateTime @default(now())
  billingCycle String

  createdAt   DateTime @default(now())

  waterBill   WaterBill?

  // VOIDING
  isVoided    Boolean   @default(false)
  voidedAt    DateTime?
  voidReason  String?

  @@index([unitId, readingDate])
  @@unique([unitId, billingCycle])
}

model Payment {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  amountReceived  Float?
  totalAllocated  Float @default(0)
  unappliedAmount Float @default(0)

  paidAt     DateTime  @default(now())
  method     String?
  reference  String?
  note       String?

  allocations PaymentAllocation[]

  isReversed     Boolean   @default(false)
  reversedAt     DateTime?
  reversalReason String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([paidAt])
}

model PaymentAllocation {
  id           Int      @id @default(autoincrement())
  paymentId    Int
  payment      Payment  @relation(fields: [paymentId], references: [id])

  billType     String   // "rent" | "water" | "deposit" | "credit"

  rentBillId   Int?
  rentBill     RentBill? @relation(fields: [rentBillId], references: [id])

  waterBillId  Int?
  waterBill    WaterBill? @relation(fields: [waterBillId], references: [id])

  amount       Float
  createdAt    DateTime @default(now())

  isReversed     Boolean @default(false)
  reversedAt     DateTime?
  reversalReason String?

  @@index([paymentId])
  @@index([billType])
}


model Maintenance {
  id          Int      @id @default(autoincrement())
  description String
  date        DateTime @default(now())
  cost        Float
  tenantId    Int?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
}

model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

enum UserRole {
  admin
  accountant
  user
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  role          UserRole
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
