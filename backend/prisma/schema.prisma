// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          Int           @id @default(autoincrement())
  name        String
  email       String        @unique
  phone       String
  units       Unit[]
  leases      Lease[]       @relation("TenantLeases")
  waterBills  WaterBill[]
  maintenance Maintenance[]
}

model Unit {
  id         Int     @id @default(autoincrement())
  unitNumber String
  status     String  @default("vacant")
  tenantId   Int?
  tenant     Tenant? @relation(fields: [tenantId], references: [id])

  leases Lease[] // leases on units too
}

model Lease {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation("TenantLeases", fields: [tenantId], references: [id])
  unitId      Int
  unit        Unit     @relation(fields: [unitId], references: [id])
  monthlyRent Float
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rentBills RentBill[]
}

model RentBill {
  id      Int      @id @default(autoincrement())
  amount  Float
  dueDate DateTime
  paid    Boolean  @default(false)

  leaseId Int
  lease   Lease   @relation(fields: [leaseId], references: [id])


  payments Payment[]

  @@index([dueDate])
  @@index([leaseId])
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  paidAt    DateTime @default(now())
  method    String?
  reference String?
  note      String?

  rentBillId Int
  rentBill   RentBill @relation(fields: [rentBillId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rentBillId])
  @@index([paidAt])
}

model WaterBill {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  previousReading Int      @default(0)
  currentReading  Int
  unitsUsed       Int
  amount          Float
  dueDate         DateTime
  status          String   @default("pending")
  createdAt       DateTime @default(now())
}

model Maintenance {
  id          Int      @id @default(autoincrement())
  description String
  date        DateTime @default(now())
  cost        Float
  tenantId    Int?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
}
